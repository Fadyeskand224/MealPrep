{
  "name": "emsmeals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,cyan \"vite --host\" \"node --watch server/index.js\"",
    "dev:web": "vite --host",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host",
    "test": "node --test --test-force-exit server/test/*.test.js",
    "check:legal": "node scripts/check-legal.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  },
  "engines": {
    "node": ">=20"
  }
}
